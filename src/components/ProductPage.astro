---
import Base from '../layouts/Base.astro';
import { velas, fragrances, fotoDe, galeriaDe, velaLoc, fragLoc } from '../data/velas.js';
import { textos, link } from '../i18n/textos.js';

const { lang = 'pt', slug } = Astro.props;
const t = textos[lang === 'en' ? 'en' : 'pt'].product;
const L = (p) => link(lang, p);

const vela = velaLoc(velas.find((v) => v.slug === slug), lang);
const frag = fragLoc(fragrances.find((f) => f.slug === vela.fragrance), lang);
const galeria = galeriaDe(vela.slug);
const outras = velas.filter((v) => v.slug !== slug).slice(0, 3).map((v) => velaLoc(v, lang));

// Título distinto em PT e EN (evita títulos duplicados entre os dois idiomas)
const metaTitulo =
  lang === 'en'
    ? `${vela.name} - ${frag.name} Candle - Malumi`
    : `${vela.name} - Vela ${frag.name} - Malumi`;

// --- Dados estruturados schema.org/Product ---
const urlProduto = `https://malumi.pt${lang === 'en' ? '/en' : ''}/product/${vela.slug}`;
const precoNum = vela.price.replace(/[^\d.,]/g, '').replace(',', '.');
const imagens = galeria.map((src) => `https://malumi.pt${src}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: vela.name,
  description: vela.line,
  sku: vela.slug,
  url: urlProduto,
  ...(imagens.length > 0 && { image: imagens }),
  brand: { '@type': 'Brand', name: 'Malumi' },
  category: lang === 'en' ? 'Scented candle' : 'Vela perfumada',
  offers: {
    '@type': 'Offer',
    url: vela.stripeUrl || urlProduto,
    price: precoNum,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: 'Malumi' },
    // Política de devolução conforme a página /devolucoes-reembolsos
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'PT',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 30,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/ReturnShippingFees',
    },
  },
};
---
<Base lang={lang} title={metaTitulo} description={vela.line} ogType="product" image={`/img/og/${vela.slug}.jpg`} jsonLd={jsonLd}>

<!-- TOPO DO PRODUTO -->
<section class="p-top">
  <div class="p-top-inner">
    {galeria.length > 0 ? (
      <div class="p-gallery">
        <div class="p-gallery-main">
          {galeria.map((src, i) => (
            <img src={src} alt={`${vela.name} - ${t.fotoAlt} ${i + 1}`} class={i === 0 ? 'g-slide active' : 'g-slide'} loading={i === 0 ? 'eager' : 'lazy'} />
          ))}
          <div class="p-img-num">{vela.num}</div>
          {galeria.length > 1 && (
            <>
              <button class="g-arrow g-prev" aria-label={t.anterior}>←</button>
              <button class="g-arrow g-next" aria-label={t.seguinte}>→</button>
              <div class="g-counter"><span class="g-idx">01</span> / {String(galeria.length).padStart(2, '0')}</div>
            </>
          )}
        </div>
        {galeria.length > 1 && (
          <div class="g-thumbs">
            {galeria.map((src, i) => (
              <button class={i === 0 ? 'g-thumb active' : 'g-thumb'} data-i={i} aria-label={`${t.fotoAlt} ${i + 1}`}>
                <img src={src} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>
    ) : (
      <div class="p-img" style={`background: ${vela.gradient};`}>
        <div class="p-img-num">{vela.num}</div>
      </div>
    )}
    <div class="p-info">
      <div class="p-eyebrow"><a href={L('/shop')} class="p-back">{t.voltar}</a></div>
      <h1 class="p-name">{vela.name}</h1>
      <div class="p-fragrance">{frag.name.toUpperCase()} · {frag.family}</div>
      <p class="p-line">{vela.line}</p>
      <div class="p-price">{vela.price}</div>
      <a href={vela.stripeUrl} class="p-buy">{t.comprar}</a>
      <div class="p-ship">{t.envio}</div>
    </div>
  </div>
</section>

{vela.inspiracao && (
  <section class="p-section">
    <div class="p-section-eyebrow">{t.inspiracao}</div>
    <p class="p-section-text">{vela.inspiracao}</p>
  </section>
)}

{(vela.fragranciaQuote || vela.fragranciaTexto) && (
  <section class="p-section p-section-alt">
    <div class="p-section-eyebrow">{t.fragrancia}</div>
    {vela.fragranciaQuote && <p class="p-quote">“{vela.fragranciaQuote}”</p>}
    {vela.fragranciaTexto && <p class="p-section-text">{vela.fragranciaTexto}</p>}
    {vela.notas && (
      <div class="p-notas">
        <div class="p-nota">
          <span class="p-nota-label">{t.familia}</span>
          <span class="p-nota-val">{vela.notas.familia}</span>
        </div>
        <div class="p-nota">
          <span class="p-nota-label">{t.topo}</span>
          <span class="p-nota-val">{vela.notas.topo}</span>
        </div>
        <div class="p-nota">
          <span class="p-nota-label">{t.coracao}</span>
          <span class="p-nota-val">{vela.notas.coracao}</span>
        </div>
        <div class="p-nota">
          <span class="p-nota-label">{t.base}</span>
          <span class="p-nota-val">{vela.notas.base}</span>
        </div>
      </div>
    )}
  </section>
)}

{(vela.detalhesIntro || vela.detalhes.length > 0) && (
  <section class="p-section">
    <div class="p-section-eyebrow">{t.detalhes}</div>
    {vela.detalhesIntro && <p class="p-section-text">{vela.detalhesIntro}</p>}
    {vela.detalhes.length > 0 && (
      <ul class="p-detalhes">
        {vela.detalhes.map((d) => <li>{d}</li>)}
      </ul>
    )}
  </section>
)}

<!-- OUTRAS PEÇAS -->
<section class="p-outras">
  <div class="p-section-eyebrow">{t.outras}</div>
  <div class="p-outras-grid">
    {outras.map((o) => {
      const of_ = fotoDe(o.slug);
      return (
        <a href={L(`/product/${o.slug}`)} class="p-outra">
          <div class="p-outra-img" style={of_ ? `background: url('${of_}') center/cover;` : `background: ${o.gradient};`}></div>
          <div class="p-outra-name">{o.name}</div>
          <div class="p-outra-price">{o.price}</div>
        </a>
      );
    })}
  </div>
</section>

</Base>

<script>
  const gal = document.querySelector('.p-gallery');
  if (gal) {
    const slides = [...gal.querySelectorAll('.g-slide')];
    const thumbs = [...gal.querySelectorAll('.g-thumb')];
    const idxEl = gal.querySelector('.g-idx');
    let cur = 0;

    function go(i) {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, n) => s.classList.toggle('active', n === cur));
      thumbs.forEach((t, n) => t.classList.toggle('active', n === cur));
      if (idxEl) idxEl.textContent = String(cur + 1).padStart(2, '0');
      thumbs[cur]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    }

    gal.querySelector('.g-prev')?.addEventListener('click', () => go(cur - 1));
    gal.querySelector('.g-next')?.addEventListener('click', () => go(cur + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(+t.dataset.i)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(cur - 1);
      if (e.key === 'ArrowRight') go(cur + 1);
    });

    const main = gal.querySelector('.p-gallery-main');
    let x0 = null;
    main.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    main.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) go(dx < 0 ? cur + 1 : cur - 1);
      x0 = null;
    }, { passive: true });
  }
</script>

<style>
/* GALERIA */
.p-gallery-main {
  position: relative;
  aspect-ratio: 4/5;
  overflow: hidden;
  background: #E9E4DA;
}
.g-slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transform: scale(1.015);
  transition: opacity 0.55s ease, transform 0.9s ease;
}
.g-slide.active {
  opacity: 1;
  transform: scale(1);
}
.g-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border: none;
  background: rgba(244,241,234,0.82);
  color: #1B2A39;
  font-size: 16px;
  cursor: pointer;
  transition: background 0.3s;
  font-family: 'Outfit', sans-serif;
  opacity: 0;
}
.p-gallery-main:hover .g-arrow { opacity: 1; }
.g-arrow:hover { background: #1B2A39; color: #F4F1EA; }
.g-prev { left: 12px; }
.g-next { right: 12px; }
.g-counter {
  position: absolute;
  bottom: 16px;
  right: 20px;
  font-size: 10px;
  letter-spacing: 2.5px;
  color: rgba(244,241,234,0.9);
  font-weight: 400;
  text-shadow: 0 0 12px rgba(0,0,0,0.35);
}
.g-thumbs {
  display: flex;
  gap: 10px;
  margin-top: 12px;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 4px;
}
.g-thumbs::-webkit-scrollbar { display: none; }
.g-thumb {
  flex: 0 0 54px;
  aspect-ratio: 1;
  padding: 0;
  border: none;
  cursor: pointer;
  opacity: 0.45;
  transition: opacity 0.3s;
  background: none;
}
.g-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.g-thumb.active, .g-thumb:hover { opacity: 1; }
.g-thumb.active { outline: 1px solid #1B2A39; outline-offset: 2px; }
@media (hover: none) {
  .g-arrow { opacity: 1; background: rgba(244,241,234,0.6); }
}

.p-top {
  padding: 72px 40px 40px;
  max-width: 940px;
  margin: 0 auto;
}
.p-top-inner {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 64px;
  align-items: center;
}
.p-img {
  aspect-ratio: 4/5;
  position: relative;
  display: flex;
  align-items: flex-end;
  padding: 24px;
}
.p-img-num {
  position: absolute;
  top: 24px;
  left: 24px;
  color: rgba(244,241,234,0.8);
  font-size: 10px;
  letter-spacing: 2.5px;
  font-weight: 400;
}
.p-eyebrow { margin-bottom: 28px; }
.p-back {
  font-size: 10px;
  letter-spacing: 2.5px;
  color: #8F9491;
  font-weight: 400;
  transition: color 0.3s;
}
.p-back:hover { color: #1B2A39; }
.p-name {
  font-size: 56px;
  color: #1B2A39;
  font-weight: 200;
  letter-spacing: -0.8px;
  margin: 0 0 12px;
  line-height: 1;
}
.p-fragrance {
  font-size: 10px;
  letter-spacing: 2.5px;
  color: #A85738;
  font-weight: 400;
  margin-bottom: 24px;
}
.p-line {
  font-size: 17px;
  color: #5F5E5A;
  font-style: italic;
  line-height: 1.65;
  margin: 0 0 32px;
  font-weight: 200;
}
.p-price {
  font-size: 26px;
  color: #1B2A39;
  font-weight: 300;
  margin-bottom: 28px;
}
.p-buy {
  display: inline-block;
  padding: 16px 40px;
  background: #1B2A39;
  color: #F4F1EA;
  border: 0.5px solid #1B2A39;
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: 400;
  transition: all 0.3s;
}
.p-buy:hover {
  background: transparent;
  color: #1B2A39;
}
.p-ship {
  margin-top: 24px;
  font-size: 9px;
  letter-spacing: 2px;
  color: #8F9491;
  font-weight: 300;
}

.p-section {
  padding: 72px 40px;
  max-width: 720px;
  margin: 0 auto;
  text-align: center;
}
.p-section-alt {
  max-width: 100%;
  background: #FAF7F0;
}
.p-section-alt > :global(*) {
  max-width: 720px;
  margin-left: auto;
  margin-right: auto;
}
.p-section-eyebrow {
  font-size: 10px;
  letter-spacing: 5px;
  color: #A85738;
  margin-bottom: 28px;
  font-weight: 400;
}
.p-section-text {
  font-size: 15px;
  color: #2A2A2A;
  line-height: 1.85;
  font-weight: 200;
  margin: 0 0 24px;
  text-align: left;
}
.p-quote {
  font-size: 24px;
  color: #1B2A39;
  font-style: italic;
  font-weight: 200;
  line-height: 1.5;
  letter-spacing: -0.3px;
  margin: 0 0 32px;
}
.p-notas {
  margin-top: 40px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  text-align: left;
}
.p-nota {
  border-top: 0.5px solid #D8D2C8;
  padding-top: 14px;
}
.p-nota-label {
  display: block;
  font-size: 9px;
  letter-spacing: 2.5px;
  color: #8F9491;
  font-weight: 400;
  margin-bottom: 8px;
}
.p-nota-val {
  font-size: 13px;
  color: #1B2A39;
  font-weight: 200;
  line-height: 1.5;
}
.p-detalhes {
  list-style: none;
  padding: 0;
  margin: 8px 0 0;
  text-align: left;
}
.p-detalhes li {
  font-size: 14px;
  color: #5F5E5A;
  line-height: 1.6;
  padding: 14px 0;
  border-top: 0.5px solid #E3DFD5;
  font-weight: 200;
}
.p-detalhes li::before {
  content: "-";
  color: #A85738;
  margin-right: 12px;
}

.p-outras {
  padding: 72px 40px 120px;
  max-width: 940px;
  margin: 0 auto;
  text-align: center;
}
.p-outras-grid {
  margin-top: 16px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.p-outra { display: block; }
.p-outra-img {
  aspect-ratio: 4/5;
  margin-bottom: 16px;
  transition: opacity 0.3s;
}
.p-outra:hover .p-outra-img { opacity: 0.85; }
.p-outra-name {
  font-size: 18px;
  color: #1B2A39;
  font-weight: 200;
}
.p-outra-price {
  font-size: 13px;
  color: #8F9491;
  font-weight: 300;
}

@media (max-width: 760px) {
  .p-top { padding: 40px 24px 24px; }
  .p-top-inner { grid-template-columns: 1fr; gap: 32px; }
  .p-name { font-size: 40px; }
  .p-section { padding: 48px 24px; }
  .p-notas { grid-template-columns: 1fr 1fr; }
  .p-outras { padding: 48px 24px 80px; }
  .p-outras-grid { grid-template-columns: 1fr; }
}
</style>
