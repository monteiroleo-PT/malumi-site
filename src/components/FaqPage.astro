---
import Base from '../layouts/Base.astro';
import { textos } from '../i18n/textos.js';

const { lang = 'pt' } = Astro.props;
const t = textos[lang === 'en' ? 'en' : 'pt'];
const d = t.faq;
---
<Base lang={lang} title={d.metaTitle} description={d.metaDesc}>

<section class="lg-hero">
  <div class="lg-hero-inner">
    <div class="lg-eyebrow">{d.eyebrow}</div>
    <h1 class="lg-titulo" set:html={d.titulo} />
    <p class="lg-intro">{d.intro}</p>
  </div>
</section>

<section class="faq-body">
  <div class="faq-inner">
    {d.grupos.map((g) => (
      <div class="faq-group">
        <h2>{g.titulo}</h2>
        <div class="faq-list">
          {g.perguntas.map(([q, a]) => (
            <details class="faq-item">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

</Base>

<style>
.lg-hero {
  background: #F4F1EA;
  padding: 120px 40px 64px;
  text-align: center;
}
.lg-hero-inner { max-width: 700px; margin: 0 auto; }
.lg-eyebrow {
  font-size: 10px;
  letter-spacing: 5px;
  color: #A85738;
  margin-bottom: 28px;
  font-weight: 400;
}
.lg-titulo {
  font-size: 48px;
  color: #1B2A39;
  font-weight: 200;
  letter-spacing: -0.6px;
  margin: 0 0 24px;
  line-height: 1.1;
}
.lg-titulo :global(em) { font-style: normal; color: #5F5E5A; }
.lg-intro {
  font-size: 15px;
  color: #5F5E5A;
  line-height: 1.75;
  margin: 0;
  font-weight: 200;
}

.faq-body {
  background: #FAF7F0;
  padding: 8px 40px 100px;
}
.faq-inner { max-width: 760px; margin: 0 auto; }
.faq-group { margin-top: 56px; }
.faq-group h2 {
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #1B2A39;
  font-weight: 400;
  margin: 0 0 20px;
  padding-bottom: 16px;
  border-bottom: 0.5px solid #D8D2C8;
}
.faq-list { display: flex; flex-direction: column; }
.faq-item {
  border-bottom: 0.5px solid #E3DFD5;
  padding: 18px 0;
}
.faq-item summary {
  cursor: pointer;
  font-size: 15px;
  color: #1B2A39;
  font-weight: 300;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16px;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after {
  content: '+';
  color: #A85738;
  font-size: 16px;
  font-weight: 300;
  flex-shrink: 0;
  transition: transform 0.25s;
}
.faq-item[open] summary::after { transform: rotate(45deg); }
.faq-item p {
  font-size: 14px;
  color: #5F5E5A;
  line-height: 1.8;
  font-weight: 200;
  margin: 14px 0 0;
  max-width: 620px;
}

@media (max-width: 760px) {
  .lg-hero { padding: 72px 24px 40px; }
  .lg-titulo { font-size: 34px; }
  .faq-body { padding: 8px 24px 64px; }
  .faq-group { margin-top: 40px; }
}
</style>
