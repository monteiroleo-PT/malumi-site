---
import Base from '../layouts/Base.astro';
import { velas, fragrances, fotoDe, velaLoc, fragLoc } from '../data/velas.js';
import { textos, link } from '../i18n/textos.js';

const { lang = 'pt' } = Astro.props;
const t = textos[lang === 'en' ? 'en' : 'pt'].home;
const L = (p) => link(lang, p);
---
<Base lang={lang} title={t.metaTitle} description={t.metaDesc}>

<!-- HERO -->
<section class="m-hero">
  <div class="m-hero-inner">
    <div>
      <div class="m-hero-eyebrow"><span class="m-hero-eyebrow-mark"></span>{t.eyebrow}</div>
      <h1 class="m-hero-title" set:html={t.titulo} />
      <p class="m-hero-sub">{t.sub}</p>
      <a href={L('/#atelier')} class="m-hero-cta">{t.cta}</a>
    </div>
    <div class="m-hero-img"></div>
  </div>

  <!-- BANDA MATÉRIA / FRAGRÂNCIA / PRESENÇA -->
  <div class="m-band">
    {['materia', 'fragrancia', 'presenca'].map((slug, i) => (
      <div class={`m-band-item m-band-${slug}`}>
        <div class="m-band-caption">
          <span class="m-band-label">{t.banda[i][0]}</span>
          <span class="m-band-quote">{t.banda[i][1]}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- FRASE-ÂNCORA -->
<section class="m-anchor">
  <p class="m-anchor-text" set:html={t.ancora} />
  <span class="m-rule"></span>
</section>

<!-- CATÁLOGO -->
<section class="m-section" id="velas">
  <div class="m-section-eyebrow">{t.catalogoEyebrow}</div>
  <h2 class="m-section-title" set:html={t.catalogoTitulo} />
  <p class="m-section-sub">{t.catalogoSub}</p>

  {fragrances.map((f0) => {
    const f = fragLoc(f0, lang);
    return (
      <div class="m-fragrance-group">
        <div class="m-fragrance-header">
          <h3 class="m-fragrance-name"><em>{f.name}</em></h3>
          <span class="m-fragrance-family">{f.family}</span>
        </div>
        <div class="m-pair">
          {velas.filter((v) => v.fragrance === f.slug).map((v0) => {
            const v = velaLoc(v0, lang);
            const foto = fotoDe(v.slug);
            return (
              <div class="m-card">
                <a href={L(`/product/${v.slug}`)} class="m-card-img" style={foto ? `background: url('${foto}') center/cover;` : `background: ${v.gradient};`}>
                  <div class="m-card-label-num">{v.num}</div>
                </a>
                <h4 class="m-card-name"><a href={L(`/product/${v.slug}`)}>{v.name}</a></h4>
                <div class="m-card-fragrance">{f.name.toUpperCase()}</div>
                <p class="m-card-line">{v.line}</p>
                <div class="m-card-meta">
                  <span class="m-card-price">{v.price}</span>
                  <a href={L(`/product/${v.slug}`)} class="m-card-link">{t.verPeca}</a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    );
  })}
</section>

<!-- ATELIER -->
<section class="m-atelier" id="atelier">
  <div class="m-atelier-inner">
    <div class="m-atelier-img">
      <div class="m-atelier-img-label">{t.atelierImgLabel}</div>
    </div>
    <div>
      <div class="m-atelier-eyebrow">{t.atelierEyebrow}</div>
      <h2 class="m-atelier-title" set:html={t.atelierTitulo} />
      <div class="m-atelier-text">
        {t.atelierTexto.map((p) => <p>{p}</p>)}
      </div>
      <div class="m-atelier-values">
        {t.valores.map(([nome, desc]) => (
          <div class="m-value">
            <p class="m-value-name">{nome}</p>
            <p class="m-value-desc">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- EDIÇÃO PRIVADA -->
<section class="m-edicao" id="edicao">
  <div class="m-edicao-grid">
    <div class="m-edicao-img">
      <div class="m-edicao-img-label">{t.edicaoImgLabel}</div>
    </div>
    <div class="m-edicao-inner">
      <div class="m-edicao-num">{t.edicaoNum}</div>
      <h2 class="m-edicao-title" set:html={t.edicaoTitulo} />
      <p class="m-edicao-text">{t.edicaoTexto}</p>
      <div class="m-edicao-note">{t.edicaoNote}</div>
      <a href={`mailto:studio@malumi.pt?subject=${encodeURIComponent(t.edicaoMailSubject)}`} class="m-edicao-cta">{t.edicaoCta}</a>
    </div>
  </div>
</section>

<!-- MALUMI BY -->
<section class="m-by" id="by">
  <div class="m-by-inner">
    <div>
      <div class="m-by-eyebrow">{t.byNum}</div>
      <h2 class="m-by-title" set:html={t.byTitulo} />
      <p class="m-by-text">{t.byTexto}</p>
      <a href={L('/by')} class="m-by-cta">{t.byCta}</a>
    </div>
    <div class="m-by-grid">
      {t.byCards.map(([glyph, titulo, texto]) => (
        <div class="m-by-card">
          <div class="m-by-card-glyph">{glyph}</div>
          <div class="m-by-card-title">{titulo}</div>
          <p class="m-by-card-text">{texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAIXA @MALUMI -->
<section class="m-insta">
  <div class="m-insta-label">{t.instaLabel}</div>
  <div class="m-insta-grid">
    {velas.map((v) => {
      const foto = fotoDe(v.slug);
      return (
        <a href={L(`/product/${v.slug}`)} class="m-insta-item" style={foto ? `background: url('${foto}') center/cover;` : `background: ${v.gradient};`} aria-label={v.name}></a>
      );
    })}
  </div>
</section>

</Base>

<style>
/* HERO */
.m-hero {
  padding: 96px 40px 0;
  background: #F4F1EA;
  max-width: 1020px;
  margin: 0 auto;
}
.m-hero-inner {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 80px;
  align-items: center;
  margin-bottom: 64px;
}
.m-hero-eyebrow {
  font-size: 10px;
  letter-spacing: 5px;
  color: #8F9491;
  margin-bottom: 32px;
  font-weight: 300;
}
.m-hero-eyebrow-mark {
  display: inline-block;
  width: 24px;
  height: 0.5px;
  background: #8F9491;
  vertical-align: middle;
  margin-right: 16px;
  opacity: 0.6;
}
.m-hero-title {
  font-size: 72px;
  line-height: 1.05;
  color: #1B2A39;
  font-weight: 200;
  letter-spacing: -1px;
  margin: 0 0 32px;
}
.m-hero-title :global(em) { font-style: italic; }
.m-hero-sub {
  font-size: 18px;
  color: #5F5E5A;
  font-style: italic;
  max-width: 560px;
  line-height: 1.65;
  margin: 0 0 48px;
  font-weight: 200;
}
.m-hero-cta {
  display: inline-block;
  padding: 16px 32px;
  background: transparent;
  color: #1B2A39;
  border: 0.5px solid #1B2A39;
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: 400;
  transition: all 0.3s;
}
.m-hero-cta:hover {
  background: #1B2A39;
  color: #F4F1EA;
}
.m-hero-img {
  width: 100%;
  max-width: 320px;
  aspect-ratio: 4/5;
  justify-self: end;
  background: url('/img/hero-atelier.jpg') center/cover;
}

/* BANDA MATÉRIA / FRAGRÂNCIA / PRESENÇA */
.m-band {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
}
.m-band-item {
  aspect-ratio: 4/3;
  display: flex;
  align-items: flex-end;
  padding: 20px 24px;
  position: relative;
}
.m-band-item::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(14,22,31,0.45) 0%, rgba(14,22,31,0) 45%);
  pointer-events: none;
}
.m-band-caption {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.m-band-label {
  color: #F4F1EA;
  font-size: 10px;
  letter-spacing: 3px;
  font-weight: 400;
  opacity: 0.95;
}
.m-band-quote {
  color: #F4F1EA;
  font-size: 13px;
  font-style: italic;
  font-weight: 200;
  opacity: 0.85;
  letter-spacing: 0.2px;
}
.m-band-materia    { background: url('/img/materia.jpg') center/cover; }
.m-band-fragrancia { background: url('/img/fragrancia.jpg') center/cover; }
.m-band-presenca   { background: url('/img/presenca.jpg') center/cover; }

/* FRASE-ÂNCORA */
.m-anchor {
  padding: 96px 40px;
  text-align: center;
  background: #F4F1EA;
  max-width: 880px;
  margin: 0 auto;
}
.m-anchor-text {
  font-size: 30px;
  line-height: 1.4;
  color: #1B2A39;
  font-weight: 200;
  letter-spacing: -0.3px;
  margin: 0;
  font-style: italic;
}
.m-rule {
  display: block;
  width: 48px;
  height: 0.5px;
  background: #1B2A39;
  margin: 32px auto 0;
  opacity: 0.3;
}

/* SECÇÕES */
.m-section {
  padding: 96px 40px;
  max-width: 960px;
  margin: 0 auto;
}
.m-section-eyebrow {
  font-size: 10px;
  letter-spacing: 5px;
  color: #8F9491;
  margin-bottom: 20px;
  text-align: center;
  font-weight: 300;
}
.m-section-title {
  font-size: 44px;
  color: #1B2A39;
  font-weight: 200;
  letter-spacing: -0.8px;
  text-align: center;
  margin: 0 0 16px;
  line-height: 1.1;
}
.m-section-title :global(em) {
  font-style: italic;
  color: #5F5E5A;
}
.m-section-sub {
  font-size: 15px;
  color: #6B6B6B;
  font-style: italic;
  text-align: center;
  max-width: 580px;
  margin: 0 auto 64px;
  line-height: 1.7;
  font-weight: 200;
}

/* CATÁLOGO */
.m-fragrance-group { margin-bottom: 96px; }
.m-fragrance-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16px;
  border-bottom: 0.5px solid #D8D2C8;
  margin-bottom: 40px;
}
.m-fragrance-name {
  font-size: 28px;
  color: #1B2A39;
  font-weight: 200;
  letter-spacing: -0.3px;
  margin: 0;
}
.m-fragrance-name em { font-style: italic; }
.m-fragrance-family {
  font-size: 10px;
  letter-spacing: 3px;
  color: #A85738;
  font-weight: 400;
}
.m-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
}
.m-card { background: #F4F1EA; }
.m-card-img {
  aspect-ratio: 1/1;
  margin-bottom: 24px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 24px;
  transition: opacity 0.3s;
}
.m-card-img:hover { opacity: 0.9; }
.m-card-label-num {
  position: absolute;
  top: 24px;
  left: 24px;
  color: rgba(244,241,234,0.8);
  font-size: 10px;
  letter-spacing: 2.5px;
  font-weight: 400;
}
.m-card-name {
  font-size: 28px;
  font-weight: 200;
  margin: 0 0 6px;
  letter-spacing: -0.3px;
}
.m-card-name a { color: #1B2A39; }
.m-card-fragrance {
  font-size: 10px;
  letter-spacing: 2.5px;
  color: #A85738;
  margin-bottom: 16px;
  font-weight: 400;
}
.m-card-line {
  font-size: 15px;
  color: #5F5E5A;
  font-style: italic;
  line-height: 1.6;
  margin: 0 0 24px;
  min-height: 48px;
  font-weight: 200;
}
.m-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 0.5px solid #D8D2C8;
  padding-top: 16px;
  font-size: 13px;
  color: #1B2A39;
}
.m-card-price {
  font-weight: 300;
  font-size: 18px;
}
.m-card-link {
  font-size: 10px;
  letter-spacing: 2.5px;
  color: #1B2A39;
  font-weight: 400;
}
.m-card-link:hover { text-decoration: underline; }

/* ATELIER */
.m-atelier {
  padding: 96px 40px;
  background: #FAF7F0;
}
.m-atelier-inner {
  max-width: 960px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 72px;
  align-items: center;
}
.m-atelier-img {
  aspect-ratio: 1/1;
  background: url('/img/atelier.jpg') center/cover;
  position: relative;
}
.m-atelier-img-label {
  position: absolute;
  bottom: 24px;
  left: 24px;
  color: #F4F1EA;
  font-size: 10px;
  letter-spacing: 3px;
  opacity: 0.85;
  font-weight: 300;
}
.m-atelier-eyebrow {
  font-size: 10px;
  letter-spacing: 5px;
  color: #8F9491;
  margin-bottom: 24px;
  font-weight: 300;
}
.m-atelier-title {
  font-size: 44px;
  color: #1B2A39;
  font-weight: 200;
  letter-spacing: -0.6px;
  line-height: 1.1;
  margin: 0 0 32px;
}
.m-atelier-title :global(em) {
  font-style: italic;
  color: #5F5E5A;
}
.m-atelier-text {
  font-size: 15px;
  color: #2A2A2A;
  line-height: 1.85;
  font-weight: 200;
}
.m-atelier-text p { margin: 0 0 20px; }
.m-atelier-text p:first-child::first-letter {
  font-size: 42px;
  color: #1B2A39;
  float: left;
  line-height: 0.9;
  padding: 6px 10px 0 0;
  font-weight: 300;
}
.m-atelier-values {
  margin-top: 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.m-value {
  padding: 16px 0;
  border-top: 0.5px solid #D8D2C8;
}
.m-value-name {
  font-size: 13px;
  color: #1B2A39;
  letter-spacing: 1px;
  margin: 0 0 4px;
  font-weight: 400;
}
.m-value-desc {
  font-size: 12px;
  color: #8F9491;
  font-style: italic;
  line-height: 1.5;
  margin: 0;
  font-weight: 200;
}

/* EDIÇÃO PRIVADA */
.m-edicao {
  background: #F4F1EA;
  padding: 96px 40px;
}
.m-edicao-grid {
  max-width: 960px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.25fr;
  gap: 0;
  align-items: stretch;
}
.m-edicao-img {
  background: url('/img/edicao-privada.jpg') center/cover;
  position: relative;
  min-height: 420px;
}
.m-edicao-img-label {
  position: absolute;
  bottom: 20px;
  left: 20px;
  color: #F4F1EA;
  font-size: 9px;
  letter-spacing: 2.5px;
  font-weight: 400;
  text-shadow: 0 0 14px rgba(0,0,0,0.4);
}
.m-edicao-inner {
  border: 0.5px solid #D8D2C8;
  border-left: none;
  padding: 64px 56px;
  background: #FAF7F0;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.m-edicao-num {
  font-size: 10px;
  letter-spacing: 4px;
  color: #A85738;
  margin-bottom: 24px;
  font-weight: 400;
}
.m-edicao-title {
  font-size: 42px;
  color: #1B2A39;
  font-weight: 200;
  margin: 0 0 24px;
  letter-spacing: -0.4px;
  line-height: 1.15;
}
.m-edicao-title :global(em) {
  font-style: italic;
  color: #5F5E5A;
}
.m-edicao-text {
  font-size: 16px;
  color: #5F5E5A;
  line-height: 1.75;
  margin: 0 0 32px;
  font-style: italic;
  font-weight: 200;
}
.m-edicao-note {
  font-size: 10px;
  letter-spacing: 3px;
  color: #8F9491;
  margin-bottom: 36px;
  font-weight: 300;
}
.m-edicao-cta {
  display: inline-block;
  padding: 14px 32px;
  background: transparent;
  color: #1B2A39;
  border: 0.5px solid #1B2A39;
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: 400;
  transition: all 0.3s;
  align-self: center;
}
.m-edicao-cta:hover {
  background: #1B2A39;
  color: #F4F1EA;
}

/* MALUMI BY */
.m-by {
  background: #1B2A39;
  color: #F4F1EA;
  padding: 120px 40px;
}
.m-by-inner {
  max-width: 1040px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.m-by-eyebrow {
  font-size: 10px;
  letter-spacing: 5px;
  color: #D8D2C8;
  margin-bottom: 24px;
  font-weight: 300;
}
.m-by-title {
  font-size: 52px;
  color: #F4F1EA;
  font-weight: 200;
  letter-spacing: -0.8px;
  line-height: 1.05;
  margin: 0 0 28px;
}
.m-by-title :global(em) {
  font-style: italic;
  color: #D8D2C8;
}
.m-by-text {
  font-size: 16px;
  color: #D8D2C8;
  line-height: 1.75;
  margin: 0 0 36px;
  font-weight: 200;
}
.m-by-cta {
  display: inline-block;
  padding: 16px 32px;
  background: transparent;
  color: #F4F1EA;
  border: 0.5px solid #F4F1EA;
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: 400;
  transition: all 0.3s;
}
.m-by-cta:hover {
  background: #F4F1EA;
  color: #1B2A39;
}
.m-by-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.m-by-card {
  border: 0.5px solid #3A4756;
  padding: 28px 24px;
}
.m-by-card-glyph {
  font-size: 24px;
  color: #D8D2C8;
  margin-bottom: 16px;
  font-weight: 200;
  line-height: 1;
}
.m-by-card-title {
  font-size: 13px;
  color: #F4F1EA;
  letter-spacing: 2px;
  margin: 0 0 8px;
  font-weight: 400;
}
.m-by-card-text {
  font-size: 12px;
  color: #8F9491;
  line-height: 1.5;
  margin: 0;
  font-weight: 200;
}

/* FAIXA @MALUMI */
.m-insta {
  background: #FAF7F0;
  padding: 72px 40px;
  text-align: center;
}
.m-insta-label {
  font-size: 10px;
  letter-spacing: 4px;
  color: #8F9491;
  font-weight: 400;
  margin-bottom: 32px;
}
.m-insta-grid {
  max-width: 840px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10px;
}
.m-insta-item {
  aspect-ratio: 1;
  display: block;
  transition: opacity 0.3s;
}
.m-insta-item:hover { opacity: 0.85; }

/* RESPONSIVE */
@media (max-width: 760px) {
  .m-hero { padding: 56px 24px 0; }
  .m-hero-inner { grid-template-columns: 1fr; gap: 40px; margin-bottom: 40px; }
  .m-hero-img { justify-self: start; }
  .m-hero-title { font-size: 44px; }
  .m-band { grid-template-columns: 1fr; gap: 10px; }
  .m-band-item { aspect-ratio: 16/7; }
  .m-section-title, .m-atelier-title, .m-by-title, .m-edicao-title { font-size: 32px; }
  .m-anchor-text { font-size: 22px; }
  .m-pair, .m-atelier-inner, .m-by-inner { grid-template-columns: 1fr; gap: 32px; }
  .m-atelier-values { grid-template-columns: 1fr; }
  .m-section, .m-atelier, .m-edicao, .m-by { padding: 64px 24px; }
  .m-edicao-grid { grid-template-columns: 1fr; }
  .m-edicao-img { min-height: 300px; }
  .m-edicao-inner { padding: 48px 28px; border-left: 0.5px solid #D8D2C8; border-top: none; }
  .m-insta { padding: 48px 24px; }
  .m-insta-grid { grid-template-columns: repeat(3, 1fr); }
}
</style>
