---
import { textos, link, comBarra } from '../i18n/textos.js';
import { velas, fragrances, fotoDe } from '../data/velas.js';

const {
  lang = 'pt',
  title = 'Malumi - Cuidado em forma de objeto.',
  description = '',
  // Imagem de partilha (Open Graph) — 1200x628, em public/img/og/
  image = '/img/og/malumi.jpg',
  ogType = 'website',
  // Dados estruturados JSON-LD: objecto ou array de objectos schema.org
  jsonLd = null,
  // Páginas que não devem aparecer nos motores de busca (ex.: /obrigado)
  noindex = false,
} = Astro.props;
const t = textos[lang === 'en' ? 'en' : 'pt'];
const L = (p) => link(lang, p);

// caminho equivalente no outro idioma (para o interruptor PT/EN e hreflang)
const base = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pathname = comBarra(base);
const ptPath = comBarra(base.replace(/^\/en(\/|$)/, '/').replace(/\/{2,}/g, '/') || '/');
const enPath = ptPath === '/' ? '/en/' : comBarra('/en' + ptPath);
const altHref = lang === 'en' ? ptPath : enPath;
const canonical = `https://malumi.pt${lang === 'en' ? enPath : ptPath}`;
const ogImage = image.startsWith('http') ? image : `https://malumi.pt${image}`;

// Catálogo mínimo para o carrinho (lido pelo script no fim da página).
// O preço aqui é só para mostrar: o valor cobrado é calculado no servidor.
const catalogoCarrinho = velas.map((v) => ({
  slug: v.slug,
  name: v.name,
  frag: fragrances.find((f) => f.slug === v.fragrance).name,
  price: parseFloat(v.price.replace(/[^\d.,]/g, '').replace(',', '.')),
  foto: fotoDe(v.slug),
  gradient: v.gradient,
  url: L(`/product/${v.slug}`),
  stripeUrl: v.stripeUrl,
}));
---
<!doctype html>
<html lang={t.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="pt-PT" href={`https://malumi.pt${ptPath}`} />
  <link rel="alternate" hreflang="en" href={`https://malumi.pt${enPath}`} />
  <link rel="alternate" hreflang="x-default" href={`https://malumi.pt${ptPath}`} />

  <!-- Open Graph / partilha em redes sociais -->
  <meta property="og:site_name" content="Malumi" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'pt_PT'} />
  <meta property="og:locale:alternate" content={lang === 'en' ? 'pt_PT' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:ital,wght@0,200;0,300;0,400;0,500;1,200;1,300&display=swap" />
</head>
<body>

  <header class="site-header">
    <div class="header-inner">
      <a href={L('/')} class="header-logo" aria-label="Malumi">
        <img src="/img/malumi-wordmark-blue.png" alt="malumi" />
      </a>
      <button class="menu-toggle" aria-label="Menu" aria-expanded="false">
        <span></span><span></span>
      </button>
      <nav class="main-nav" aria-label="Menu">
        <a href={L('/#atelier')}>{t.nav.atelier}</a>
        <a href={L('/shop')}>{t.nav.velas}</a>
        <a href={L('/#edicao')}>{t.nav.edicao}</a>
        <a href={L('/by')}>{t.nav.by}</a>
        <a href={L('/#conversar')}>{t.nav.conversar}</a>
        <span class="lang-switch">
          <a href={lang === 'en' ? altHref : pathname} class={lang !== 'en' ? 'on' : ''}>PT</a>
          <span class="lang-sep">/</span>
          <a href={lang === 'en' ? pathname : altHref} class={lang === 'en' ? 'on' : ''}>EN</a>
        </span>
      </nav>
      <button class="cart-btn" type="button" data-cart-open aria-label={t.cart.abrir} aria-controls="carrinho">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5.5 8.5h13l-1 11.5h-11z" />
          <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" />
        </svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </button>
    </div>
  </header>

  <!-- CARRINHO (painel lateral) -->
  <div class="cart-overlay" data-cart-close hidden></div>
  <aside class="cart" id="carrinho" aria-label={t.cart.titulo} aria-hidden="true" data-lang={lang === 'en' ? 'en' : 'pt'}>
    <div class="cart-head">
      <h2 class="cart-title">{t.cart.titulo}</h2>
      <button class="cart-close" type="button" data-cart-close aria-label={t.cart.fechar}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
      </button>
    </div>
    <div class="cart-empty" data-cart-empty>
      <p>{t.cart.vazio}</p>
      <a href={L('/shop')} class="cart-empty-link">{t.cart.verVelas}</a>
    </div>
    <ul class="cart-lines" data-cart-lines></ul>
    <div class="cart-foot" data-cart-foot hidden>
      <div class="cart-subtotal">
        <span>{t.cart.subtotal}</span>
        <span data-cart-subtotal></span>
      </div>
      <p class="cart-note">{t.cart.envioNota}</p>
      <p class="cart-error" data-cart-error role="alert" hidden>{t.cart.erro} <a href="mailto:info@malumi.pt">info@malumi.pt</a></p>
      <button class="cart-checkout" type="button" data-cart-checkout data-label={t.cart.finalizar} data-label-busy={t.cart.aFinalizar}>{t.cart.finalizar}</button>
      <button class="cart-continue" type="button" data-cart-close>{t.cart.continuar}</button>
    </div>
  </aside>
  <script type="application/json" id="cart-data" set:html={JSON.stringify({
    velas: catalogoCarrinho,
    t: { remover: t.cart.remover, menos: t.cart.menos, mais: t.cart.mais },
  })} />

  <main>
    <slot />
  </main>

  <footer class="site-footer" id="conversar">
    <div class="footer-inner">
      <div class="footer-col footer-brand">
        <img src="/img/malumi-wordmark-sand.png" alt="malumi" class="footer-logo" />
        <p class="footer-tagline" set:html={t.footer.tagline} />
        <p class="footer-slogan">{t.footer.slogan}</p>
      </div>
      <div class="footer-col">
        <h3>{t.footer.catalogo}</h3>
        <a href={L('/shop#primavera-em-sintra')}>Primavera em Sintra</a>
        <a href={L('/shop#golden-oud')}>Golden Oud</a>
        <a href={L('/shop#serenata-di-fiori')}>Serenata di Fiori</a>
        <a href={L('/#edicao')}>{t.footer.edicaoPrivada}</a>
      </div>
      <div class="footer-col">
        <h3>{t.footer.by}</h3>
        {t.footer.byLinks.map((label) => <a href={L('/by')}>{label}</a>)}
      </div>
      <div class="footer-col">
        <h3>{t.footer.apoioTitulo}</h3>
        <a href={L('/faq')}>{t.footer.faq}</a>
        <a href={L('/cuidado-fragrancia')}>{t.footer.cuidado}</a>
        <a href={L('/pagamentos-envio')}>{t.footer.pagamentos}</a>
        <a href={L('/devolucoes-reembolsos')}>{t.footer.devolucoes}</a>
        <a href={L('/sustentabilidade')}>{t.footer.sustentabilidade}</a>
      </div>
      <div class="footer-col">
        <h3>{t.footer.conversar}</h3>
        <a href="mailto:info@malumi.pt">info@malumi.pt</a>
        <div class="footer-social">
          <a href="https://www.instagram.com/malumi.pt/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href="https://pt.pinterest.com/malumi_pt/" target="_blank" rel="noopener" aria-label="Pinterest">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M9 16.5c.8-2.7 1.6-5.4 2.1-7.3.6-2.2 3.6-2.3 4.4-.4.6 1.5.2 3.4-.5 4.9-.6 1.3-1.8 2.1-3.1 2-.6 0-1.1-.3-1.4-.7" />
              <path d="M11 12.2c0-1.6 1.2-2.9 2.7-2.9" />
            </svg>
          </a>
        </div>
        <span class="footer-plain">{t.footer.atelierLocal}</span>
        <span class="footer-plain">{t.footer.officeLocal}</span>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{t.footer.copyright}</span>
      <span class="footer-legal-links">
        <a href={L('/politica-privacidade')}>{t.footer.privacidade}</a>
        <span class="footer-legal-sep">·</span>
        <a href={L('/termos-venda')}>{t.footer.termosVenda}</a>
        <span class="footer-legal-sep">·</span>
        <a href={L('/termos-condicoes')}>{t.footer.termosCondicoes}</a>
      </span>
    </div>
  </footer>

  <script>
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('.main-nav');
    toggle?.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }));
  </script>

  <script>
    // ============================================================
    // CARRINHO
    // Guardado no browser (localStorage). Os botões com data-add="<slug>"
    // juntam a vela ao carrinho; sem JavaScript continuam a ser links
    // directos para o Payment Link dessa vela.
    // O pagamento é criado em /api/checkout (netlify/functions/checkout.mjs).
    // ============================================================
    const CHAVE = 'malumi-cart';
    const MAX = 10;
    const dados = JSON.parse(document.getElementById('cart-data')?.textContent || '{"velas":[],"t":{}}');
    const catalogo = new Map(dados.velas.map((v) => [v.slug, v]));
    const painel = document.getElementById('carrinho');
    const overlay = document.querySelector('.cart-overlay');
    const $ = (sel) => painel.querySelector(sel);
    const lang = painel.dataset.lang;
    let memoria = [];
    let ultimoFoco = null;

    function ler() {
      try {
        const bruto = JSON.parse(localStorage.getItem(CHAVE) || '[]');
        memoria = (Array.isArray(bruto) ? bruto : [])
          .filter((i) => catalogo.has(i?.slug) && Number.isInteger(i.qty) && i.qty >= 1)
          .map((i) => ({ slug: i.slug, qty: Math.min(MAX, i.qty) }));
      } catch {}
      return memoria;
    }
    function guardar(itens) {
      memoria = itens;
      try { localStorage.setItem(CHAVE, JSON.stringify(itens)); } catch {}
      desenhar();
    }
    const euros = (n) => '€ ' + (Number.isInteger(n) ? n : n.toFixed(2).replace('.', ','));

    function el(tag, attrs = {}, ...filhos) {
      const e = document.createElement(tag);
      for (const [k, v] of Object.entries(attrs)) {
        if (k === 'class') e.className = v;
        else if (k === 'text') e.textContent = v;
        else e.setAttribute(k, v);
      }
      e.append(...filhos);
      return e;
    }

    function desenhar() {
      const itens = memoria;
      const total = itens.reduce((s, i) => s + i.qty, 0);
      document.querySelectorAll('[data-cart-count]').forEach((c) => {
        c.textContent = String(total);
        c.hidden = total === 0;
      });
      $('[data-cart-empty]').hidden = itens.length > 0;
      $('[data-cart-foot]').hidden = itens.length === 0;

      const lista = $('[data-cart-lines]');
      lista.replaceChildren(...itens.map((i) => {
        const v = catalogo.get(i.slug);
        const img = el('a', { class: 'cart-line-img', href: v.url, 'aria-label': v.name });
        img.style.background = v.foto ? `url('${v.foto}') center/cover` : v.gradient;
        return el('li', { class: 'cart-line' },
          img,
          el('div', { class: 'cart-line-info' },
            el('a', { class: 'cart-line-name', href: v.url, text: v.name }),
            el('div', { class: 'cart-line-frag', text: v.frag.toUpperCase() }),
            el('div', { class: 'cart-line-qty' },
              el('button', { type: 'button', 'data-qty': '-1', 'data-slug': i.slug, 'aria-label': dados.t.menos, text: '−' }),
              el('span', { text: String(i.qty) }),
              el('button', { type: 'button', 'data-qty': '1', 'data-slug': i.slug, 'aria-label': dados.t.mais, text: '+', ...(i.qty >= MAX && { disabled: '' }) }),
            ),
          ),
          el('div', { class: 'cart-line-side' },
            el('span', { class: 'cart-line-price', text: euros(v.price * i.qty) }),
            el('button', { type: 'button', class: 'cart-line-remove', 'data-remove': i.slug, text: dados.t.remover }),
          ),
        );
      }));
      $('[data-cart-subtotal]').textContent = euros(itens.reduce((s, i) => s + catalogo.get(i.slug).price * i.qty, 0));
    }

    function mudar(slug, delta) {
      const itens = memoria.map((i) => ({ ...i }));
      const item = itens.find((i) => i.slug === slug);
      if (item) item.qty = Math.min(MAX, item.qty + delta);
      else if (delta > 0) itens.push({ slug, qty: 1 });
      guardar(itens.filter((i) => i.qty >= 1));
    }

    function abrir() {
      ultimoFoco = document.activeElement;
      $('[data-cart-error]').hidden = true;
      overlay.hidden = false;
      painel.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('cart-open');
      $('.cart-close').focus({ preventScroll: true });
    }
    function fechar() {
      overlay.hidden = true;
      painel.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('cart-open');
      ultimoFoco?.focus?.({ preventScroll: true });
    }

    async function finalizar(botao) {
      const itens = memoria;
      if (!itens.length) return;
      const erro = $('[data-cart-error]');
      erro.hidden = true;
      botao.disabled = true;
      botao.textContent = botao.dataset.labelBusy;
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lang, items: itens, voltar: location.href }),
        });
        const json = await res.json();
        if (!res.ok || !json.url) throw new Error(json.error || 'checkout');
        location.href = json.url;
      } catch {
        // Rede de segurança: com um só modelo, segue para o Payment Link dele.
        if (itens.length === 1) {
          location.href = catalogo.get(itens[0].slug).stripeUrl;
          return;
        }
        erro.hidden = false;
        botao.disabled = false;
        botao.textContent = botao.dataset.label;
      }
    }

    document.addEventListener('click', (ev) => {
      const alvo = ev.target.closest('[data-add], [data-cart-open], [data-cart-close], [data-qty], [data-remove], [data-cart-checkout]');
      if (!alvo) return;
      if (alvo.matches('[data-add]')) {
        if (!catalogo.has(alvo.dataset.add)) return; // segue o link normal
        ev.preventDefault();
        mudar(alvo.dataset.add, 1);
        abrir();
      } else if (alvo.matches('[data-cart-open]')) abrir();
      else if (alvo.matches('[data-cart-close]')) fechar();
      else if (alvo.matches('[data-qty]')) mudar(alvo.dataset.slug, Number(alvo.dataset.qty));
      else if (alvo.matches('[data-remove]')) mudar(alvo.dataset.remove, -MAX);
      else if (alvo.matches('[data-cart-checkout]')) finalizar(alvo);
    });
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && painel.getAttribute('aria-hidden') === 'false') fechar();
    });
    // Outro separador mexeu no carrinho, ou o cliente voltou atrás do Stripe.
    window.addEventListener('storage', (ev) => { if (ev.key === CHAVE) { ler(); desenhar(); } });
    window.addEventListener('pageshow', () => {
      const b = $('[data-cart-checkout]');
      b.disabled = false;
      b.textContent = b.dataset.label;
      ler();
      desenhar();
    });
    ler();
    desenhar();
  </script>
</body>
</html>

<style is:global>
/* Texto lido por motores de busca e leitores de ecrã, invisível no ecrã. */
.texto-oculto {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  section[id] { scroll-margin-top: 90px; }
  body {
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 200;
    color: #2A2A2A;
    background: #F4F1EA;
    line-height: 1.7;
    letter-spacing: 0.01em;
    margin: 0;
    padding: 0;
  }
  strong, b { font-weight: 400; }
  a { text-decoration: none; }
  img { max-width: 100%; }

  /* HEADER */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #F4F1EA;
    border-bottom: 0.5px solid #E3DFD5;
  }
  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-logo { margin-right: auto; }
  .header-logo img { height: 30px; width: auto; display: block; }
  .main-nav { display: flex; gap: 36px; align-items: center; }
  .main-nav a {
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 2.5px;
    text-transform: lowercase;
    color: #1B2A39;
    transition: color 0.3s;
  }
  .main-nav a:hover { color: #5F5E5A; }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    padding-left: 24px;
    border-left: 0.5px solid #D8D2C8;
  }
  .lang-switch a {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8F9491;
    font-weight: 300;
  }
  .lang-switch a.on { color: #1B2A39; font-weight: 400; }
  .lang-switch a:hover { color: #1B2A39; }
  .lang-sep { color: #D8D2C8; font-size: 10px; }
  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    width: 22px;
    height: 1px;
    background: #1B2A39;
    margin: 6px 0;
  }

  /* CARRINHO */
  .cart-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    padding: 6px;
    margin-left: 22px;
    color: #1B2A39;
    cursor: pointer;
    font-family: inherit;
  }
  .cart-btn svg { width: 22px; height: 22px; display: block; }
  .cart-btn:hover { color: #5F5E5A; }
  .cart-count {
    position: absolute;
    top: -2px;
    right: -6px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: #A85738;
    color: #F4F1EA;
    font-size: 9px;
    font-weight: 400;
    line-height: 16px;
    text-align: center;
    letter-spacing: 0;
  }
  .cart-count[hidden] { display: none; }
  html.cart-open { overflow: hidden; }
  .cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(27, 42, 57, 0.35);
  }
  .cart-overlay[hidden] { display: none; }
  .cart {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 210;
    width: min(420px, 100vw);
    background: #F4F1EA;
    border-left: 0.5px solid #D8D2C8;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.35s ease, visibility 0s linear 0.35s;
  }
  .cart[aria-hidden="false"] {
    transform: none;
    visibility: visible;
    transition: transform 0.35s ease;
  }
  .cart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26px 28px 22px;
    border-bottom: 0.5px solid #E3DFD5;
  }
  .cart-title {
    margin: 0;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 400;
    color: #1B2A39;
  }
  .cart-close {
    background: none;
    border: none;
    padding: 4px;
    color: #1B2A39;
    cursor: pointer;
  }
  .cart-close svg { width: 18px; height: 18px; display: block; }
