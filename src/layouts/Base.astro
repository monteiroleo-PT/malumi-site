---
import { textos, link } from '../i18n/textos.js';

const { lang = 'pt', title = 'Malumi - Cuidado em forma de objeto.', description = '' } = Astro.props;
const t = textos[lang === 'en' ? 'en' : 'pt'];
const L = (p) => link(lang, p);

// caminho equivalente no outro idioma (para o interruptor PT/EN e hreflang)
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const ptPath = pathname.replace(/^\/en(\/|$)/, '/').replace(/\/{2,}/g, '/') || '/';
const enPath = ptPath === '/' ? '/en/' : '/en' + ptPath;
const altHref = lang === 'en' ? ptPath : enPath;
---
<!doctype html>
<html lang={t.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" hreflang="pt-PT" href={`https://malumi.pt${ptPath}`} />
  <link rel="alternate" hreflang="en" href={`https://malumi.pt${enPath}`} />
  <link rel="alternate" hreflang="x-default" href={`https://malumi.pt${ptPath}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:ital,wght@0,200;0,300;0,400;0,500;1,200;1,300&display=swap" />
</head>
<body>

  <header class="site-header">
    <div class="header-inner">
      <a href={L('/')} class="header-logo" aria-label="Malumi">
        <img src="/img/malumi-wordmark-blue.png" alt="malumi" />
      </a>
      <button class="menu-toggle" aria-label="Menu" aria-expanded="false">
        <span></span><span></span>
      </button>
      <nav class="main-nav" aria-label="Menu">
        <a href={L('/#atelier')}>{t.nav.atelier}</a>
        <a href={L('/shop')}>{t.nav.velas}</a>
        <a href={L('/#edicao')}>{t.nav.edicao}</a>
        <a href={L('/by')}>{t.nav.by}</a>
        <a href={L('/#conversar')}>{t.nav.conversar}</a>
        <span class="lang-switch">
          <a href={lang === 'en' ? altHref : pathname} class={lang !== 'en' ? 'on' : ''}>PT</a>
          <span class="lang-sep">/</span>
          <a href={lang === 'en' ? pathname : altHref} class={lang === 'en' ? 'on' : ''}>EN</a>
        </span>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer" id="conversar">
    <div class="footer-inner">
      <div class="footer-col footer-brand">
        <img src="/img/malumi-wordmark-sand.png" alt="malumi" class="footer-logo" />
        <p class="footer-tagline" set:html={t.footer.tagline} />
        <p class="footer-slogan">{t.footer.slogan}</p>
      </div>
      <div class="footer-col">
        <h3>{t.footer.catalogo}</h3>
        <a href={L('/shop#primavera-em-sintra')}>Primavera em Sintra</a>
        <a href={L('/shop#golden-oud')}>Golden Oud</a>
        <a href={L('/shop#serenata-di-fiori')}>Serenata di Fiori</a>
        <a href={L('/#edicao')}>{t.footer.edicaoPrivada}</a>
      </div>
      <div class="footer-col">
        <h3>{t.footer.by}</h3>
        {t.footer.byLinks.map((label) => <a href={L('/by')}>{label}</a>)}
      </div>
      <div class="footer-col">
        <h3>{t.footer.conversar}</h3>
        <a href="mailto:studio@malumi.pt">studio@malumi.pt</a>
        <div class="footer-social">
          <a href="https://www.instagram.com/malumi.pt/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href="https://pt.pinterest.com/malumi_pt/" target="_blank" rel="noopener" aria-label="Pinterest">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M9 16.5c.8-2.7 1.6-5.4 2.1-7.3.6-2.2 3.6-2.3 4.4-.4.6 1.5.2 3.4-.5 4.9-.6 1.3-1.8 2.1-3.1 2-.6 0-1.1-.3-1.4-.7" />
              <path d="M11 12.2c0-1.6 1.2-2.9 2.7-2.9" />
            </svg>
          </a>
        </div>
        <span class="footer-plain">{t.footer.atelierLocal}</span>
        <span class="footer-plain">{t.footer.officeLocal}</span>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{t.footer.copyright}</span>
      <span>{t.footer.legal}</span>
    </div>
  </footer>

  <script>
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('.main-nav');
    toggle?.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }));
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  section[id] { scroll-margin-top: 90px; }
  body {
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 200;
    color: #2A2A2A;
    background: #F4F1EA;
    line-height: 1.7;
    letter-spacing: 0.01em;
    margin: 0;
    padding: 0;
  }
  strong, b { font-weight: 400; }
  a { text-decoration: none; }
  img { max-width: 100%; }

  /* HEADER */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #F4F1EA;
    border-bottom: 0.5px solid #E3DFD5;
  }
  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-logo img { height: 30px; width: auto; display: block; }
  .main-nav { display: flex; gap: 36px; align-items: center; }
  .main-nav a {
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 2.5px;
    text-transform: lowercase;
    color: #1B2A39;
    transition: color 0.3s;
  }
  .main-nav a:hover { color: #5F5E5A; }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    padding-left: 24px;
    border-left: 0.5px solid #D8D2C8;
  }
  .lang-switch a {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8F9491;
    font-weight: 300;
  }
  .lang-switch a.on { color: #1B2A39; font-weight: 400; }
  .lang-switch a:hover { color: #1B2A39; }
  .lang-sep { color: #D8D2C8; font-size: 10px; }
  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    width: 22px;
    height: 1px;
    background: #1B2A39;
    margin: 6px 0;
  }

  /* FOOTER */
  .site-footer {
    background: #1B2A39;
    color: #D8D2C8;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 40px 64px;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
  }
  .footer-logo { height: 26px; width: auto; margin-bottom: 20px; }
  .footer-tagline {
    font-style: italic;
    font-weight: 200;
    font-size: 14px;
    color: #D8D2C8;
    margin: 0;
    line-height: 1.7;
  }
  .footer-slogan {
    margin: 18px 0 0;
    font-size: 9px;
    letter-spacing: 3px;
    color: #8F9491;
    font-weight: 400;
  }
  .footer-col h3 {
    color: #F4F1EA;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 400;
    margin: 0 0 20px;
  }
  .footer-col a, .footer-plain {
    display: block;
    color: #8F9491;
    font-size: 13px;
    font-weight: 200;
    margin-bottom: 12px;
    transition: color 0.3s;
  }
  .footer-col a:hover { color: #F4F1EA; }
  .footer-social {
    display: flex;
    gap: 16px;
    margin: 4px 0 16px;
  }
  .footer-social a {
    display: block;
    margin: 0;
    color: #8F9491;
    transition: color 0.3s;
  }
  .footer-social a:hover { color: #F4F1EA; }
  .footer-social svg { width: 18px; height: 18px; display: block; }
  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 40px 32px;
    border-top: 0.5px solid #2F3F4F;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    color: #6B7B86;
    font-size: 10px;
    letter-spacing: 1px;
    font-weight: 300;
  }

  @media (max-width: 760px) {
    .header-inner { padding: 16px 24px; }
    .menu-toggle { display: block; }
    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #F4F1EA;
      border-bottom: 0.5px solid #E3DFD5;
      flex-direction: column;
      gap: 0;
      padding: 8px 24px 16px;
      align-items: flex-start;
    }
    .main-nav.open { display: flex; }
    .main-nav a { padding: 12px 0; }
    .lang-switch { border-left: none; padding-left: 0; margin: 8px 0 0; }
    .footer-inner { grid-template-columns: 1fr; gap: 40px; padding: 56px 24px 40px; }
    .footer-bottom { padding: 20px 24px 28px; }
  }
</style>
